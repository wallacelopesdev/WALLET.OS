# Copie para .env.local e preencha. NUNCA versione o .env.local.

# --- Supabase (obrigatório fora do modo demonstração) ---
# Painel Supabase > Project Settings > API Keys. Use a URL do projeto e a
# chave publishable (sb_publishable_...) ou anon (JWT com role "anon").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada somente no servidor (Fase 2+: jobs, tokens OAuth). Nunca exponha no frontend.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Fases seguintes (ainda não utilizadas na Fase 1) ---
# Chave de 32 bytes em base64 para criptografar tokens OAuth: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LLM_API_KEY=
