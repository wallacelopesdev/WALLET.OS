# Modelo: copie para .env.local e preencha LÁ. Este arquivo é versionado e o repositório
# é público: nunca coloque valores reais aqui.

# --- Supabase (obrigatório fora do modo demonstração) ---
# Painel Supabase > Project Settings > API Keys. Use a URL do projeto (https://....supabase.co)
# e a chave publishable (sb_publishable_...) ou anon. Nunca a chave secreta (sb_secret_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Open Finance pelo Meu Pluggy (opcional). Somente no servidor. ---
# dashboard.pluggy.ai > Aplicação: Client ID e Client Secret.
# Os IDs das conexões são adicionados em Financial Agent > Conexões. PLUGGY_ITEM_IDS é opcional:
# os IDs listados ali (separados por vírgula) entram como conexões ao abrir a lista de contas.
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# PLUGGY_ITEM_IDS=
# Aviso opcional da Pluggy (webhook): texto aleatório longo, enviado no cabeçalho
# x-wallet-webhook-secret. Sem ele, a sincronização só ocorre pelo agendador e pelo botão.
# PLUGGY_WEBHOOK_SECRET=

# --- Sincronização diária na Vercel (opcional) ---
# CRON_SECRET: texto aleatório longo, gere com: openssl rand -hex 32
# WALLET_SYNC_TOKEN: token criado em Financial Agent > Conexões
# CRON_SECRET=
# WALLET_SYNC_TOKEN=

# --- Conversa do agente com perguntas livres (opcional). Somente no servidor. ---
# Sem esta chave, a conversa responde às perguntas conhecidas sem enviar nada para fora.
# ANTHROPIC_API_KEY=

# --- Fases seguintes (ainda não utilizadas) ---
# Usada somente no servidor. Nunca exponha no frontend.
# SUPABASE_SERVICE_ROLE_KEY=
# Chave de 32 bytes em base64 para criptografar tokens OAuth: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LLM_API_KEY=
